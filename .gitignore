# --- environments ---
.venv
__pycache__/

# --- packaging artifacts (packages/denali-audit builds these on `pip install -e .`) ---
*.egg-info/
build/
dist/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# --- large public raw data: re-downloadable, see docs/DATASETS.md ---
data/raw/
data/validation_raw/

# --- breadth-probe substrate: 107 MB of public ChIP-Atlas job results and the
#     1.2M-row set-level table derived from them. Handled exactly like data/raw/ --
#     re-fetchable, so results/breadth/regions/README.md carries the URLs and the
#     derived per-job table is committed instead. See results/breadth/README.md.
results/breadth/regions/raw/
results/breadth/regions/set_size_hits.csv.gz
# published supplementary workbooks for evaluation 8; URLs in docs/OFFTARGET.md
data/offtarget/

# --- OS / editor ---
.DS_Store
*.swp

# --- secrets ---
.env
*.key
*_API_KEY*

# --- scratch ---
scratch/
tmp/
*.log

# --- large regenerable intermediates (NOT results) ---
# atlas_obs.parquet  : regenerate with `python -m src.atlas_census`   (~2 min)
# *__counts.parquet  : regenerate with `python -m src.pseudobulk "<cell type>"`
data/metadata/atlas_obs.parquet
data/processed/*__counts.parquet
